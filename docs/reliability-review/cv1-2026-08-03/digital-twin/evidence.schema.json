{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omi.me/schemas/cv1-digital-twin-evidence-v1.json",
  "title": "CV1 digital-twin campaign evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "source",
    "environment",
    "started_at",
    "finished_at",
    "overall_status",
    "scenarios",
    "changed_paths",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "manifest_sha256", "dirty"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dirty": {"type": "boolean"},
        "baseline_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["host", "os", "architecture", "container_image"],
      "properties": {
        "host": {"type": "string"},
        "os": {"type": "string"},
        "architecture": {"type": "string"},
        "container_image": {"type": "string"},
        "kimi_version": {"type": "string"},
        "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["pass", "fail", "incomplete"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "seed", "status", "duration_ms", "assertions", "metrics", "log"],
        "properties": {
          "id": {"type": "string"},
          "seed": {"type": "integer", "minimum": 0},
          "status": {"enum": ["pass", "fail", "skip"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "passed"],
              "properties": {
                "name": {"type": "string"},
                "passed": {"type": "boolean"},
                "detail": {"type": "string"}
              }
            }
          },
          "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
          "log": {"type": "string"},
          "broken_control_status": {"enum": ["rejected", "unexpected_pass", "not_run"]}
        }
      }
    },
    "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
